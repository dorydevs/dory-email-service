{{!--
  Acknowledgement sent the moment Xendit confirms a rider's gear payment.
  Triggered from groceria-api fulfillGearOrder (the webhook the payment relay
  calls), with the view-model from utilities/buildGearReceiptEmailData.js.

  Companion to rider-gear-dispatch.hbs, which covers the same order once it ships.

  This is deliberately NOT a receipt. It confirms that the order was taken and
  says what is coming; it prints no unit price, no shipping fee and no total.
  The view-model still carries those values, so nothing upstream had to change —
  they are simply not rendered here. If a priced document is ever needed, add a
  separate template rather than putting money back into this one.

  Every value arrives pre-formatted — no arithmetic or currency formatting here.

  Layout rules this file follows:
    - ONE card. Inside it, sections are separated by space and hairlines, not by
      nested tinted boxes. The only panel with a background is the non-refundable
      notice, so that it is unmistakably the thing to read.
    - the rider's name comes from fullName, never firstName: this is the name the
      courier will be handed, so it has to match end to end.
    - tables only where columns must align (label/value), not as decoration
    - inline styles for anything that must survive; Gmail keeps <style> but
      strips @import, and older Outlook ignores most of it
    - no flexbox, no background-image, and no rounded corner is load-bearing —
      Outlook squares every radius
    - bgcolor attributes shadow the CSS colours for Outlook 2007–2019
    - the <style> block only adds progressive extras (dark mode, narrow screens)
      and always uses !important, since inline styles outrank it

  The sender is noreply@ and nothing sets a reply-to, so the footer says plainly
  that replies are not read. If a monitored address is ever added, that footer
  line is what changes.
--}}
<!DOCTYPE html>
<html lang="en" dir="ltr" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta name="format-detection" content="telephone=no,address=no,email=no" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <title>{{referenceNumber}}</title>
    <style type="text/css">
      /* Outlook: stop it inventing line-height and stretching tables */
      table,
      td {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }
      /* Stop iOS/Android auto-linking addresses and dates in their own blue */
      a[x-apple-data-detectors],
      .unstyled-link a {
        color: inherit !important;
        text-decoration: none !important;
        font-size: inherit !important;
        font-weight: inherit !important;
      }

      @media only screen and (max-width: 480px) {
        .gutter {
          padding-left: 22px !important;
          padding-right: 22px !important;
        }
        .headline {
          font-size: 24px !important;
          line-height: 30px !important;
        }
        /* Label/value pairs stack instead of squeezing into two narrow columns */
        .stack-label {
          display: block !important;
          width: 100% !important;
          padding-bottom: 2px !important;
        }
        .stack-value {
          display: block !important;
          width: 100% !important;
          padding-bottom: 14px !important;
        }
      }

      @media (prefers-color-scheme: dark) {
        .page,
        .page-bg {
          background-color: #10120f !important;
        }
        .card {
          background-color: #191c18 !important;
          border-color: #2a2f29 !important;
        }
        .ink {
          color: #f1f4f1 !important;
        }
        .muted {
          color: #9aa69f !important;
        }
        .hairline {
          border-color: #2a2f29 !important;
        }
        /* The paid green is a dark-on-light value; unchanged it goes nearly
           invisible on the dark card. */
        .pos {
          color: #6fd98c !important;
        }
        /* The notice keeps its warm tint so it stays the loudest thing here */
        .warn {
          background-color: #2e1b12 !important;
        }
        .warn-ink {
          color: #ffc9ac !important;
        }
      }
    </style>
  </head>
  <body
    class="page"
    style="margin:0;padding:0;width:100% !important;background-color:#EEF0F3;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;font-family:'Nunito Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;"
  >
    {{!-- Inbox preview line: confirmation and the warning, the two things worth
          seeing before opening. No amount, same as the card. --}}
    <div
      style="display:none;visibility:hidden;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;"
    >
      Order confirmed · {{referenceNumber}} · final sale, non-refundable.
    </div>

    <table
      class="page-bg"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      role="presentation"
      bgcolor="#EEF0F3"
      style="background-color:#EEF0F3;margin:0;padding:0;"
    >
      <tr>
        <td align="center" style="padding:32px 12px;">
          <!--[if mso]>
          <table width="560" cellpadding="0" cellspacing="0" border="0" role="presentation"><tr><td>
          <![endif]-->
          <table
            class="card"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            role="presentation"
            bgcolor="#FFFFFF"
            style="max-width:560px;width:100%;background-color:#FFFFFF;border:1px solid #E3E8E5;border-radius:14px;"
          >

            {{!-- Brand bar, on the card rather than in a filled band: the
                  wordmark in ink reads as letterhead. A hairline under it does
                  the separating the black band used to do. "Order confirmed",
                  not "Receipt": in PH, "Official Receipt" names a BIR-regulated
                  document, and this email is now explicitly not one. --}}
            <tr>
              <td
                bgcolor="#FFFFFF"
                class="gutter hairline"
                style="background-color:#FFFFFF;padding:20px 32px;border-bottom:1px solid #EDF0EE;border-radius:13px 13px 0 0;font-size:16px;font-weight:700;letter-spacing:1.6px;mso-line-height-rule:exactly;line-height:20px;"
              >
                <span class="ink" style="color:#0F1A14;">DORY</span><span
                  class="muted"
                  style="font-size:10px;font-weight:700;color:#8E9A94;letter-spacing:1.6px;"
                >
                  &nbsp;&nbsp;ORDER CONFIRMED</span
                >
              </td>
            </tr>

            {{!-- The message. One clause, not two: this email exists to say the
                  order arrived, and nothing else. What happens next is the
                  footer's job and the dispatch email's job, so saying it here as
                  well only invited the question of which promise this was. --}}
            <tr>
              <td class="gutter" align="center" style="padding:36px 32px 0;">
                <p
                  class="pos"
                  style="margin:0;font-size:11px;font-weight:700;color:#1E7A33;letter-spacing:1.4px;text-transform:uppercase;mso-line-height-rule:exactly;line-height:14px;"
                >
                  &#10003;&nbsp; Payment received
                </p>
                <p
                  class="headline ink"
                  style="margin:14px 0 0;font-size:28px;font-weight:700;color:#0F1A14;letter-spacing:-0.5px;mso-line-height-rule:exactly;line-height:34px;"
                >
                  Thanks{{#if fullName}}, {{fullName}}{{/if}}
                </p>
                <p
                  class="muted"
                  style="margin:10px 0 0;font-size:15px;color:#6B7671;mso-line-height-rule:exactly;line-height:22px;"
                >
                  We've received your order.
                </p>
                {{!-- Labelled, because a bare code means nothing to the rider
                      holding it. --}}
                <p
                  class="muted"
                  style="margin:24px 0 0;font-size:10px;font-weight:700;color:#8E9A94;letter-spacing:1.3px;text-transform:uppercase;mso-line-height-rule:exactly;line-height:13px;"
                >
                  Order reference
                </p>
                <p
                  class="ink unstyled-link"
                  style="margin:3px 0 0;font-size:14px;font-weight:700;color:#3C4A43;letter-spacing:0.7px;mso-line-height-rule:exactly;line-height:18px;"
                >
                  {{referenceNumber}}
                </p>
              </td>
            </tr>

            {{!-- What was ordered. Names and quantities only — no unit price, no
                  line total, no totals block. The rider is checking that the
                  right thing in the right size is on its way. --}}
            <tr>
              <td class="gutter" style="padding:32px 32px 0;">
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  role="presentation"
                >
                  <tr>
                    <td
                      class="muted"
                      style="padding:0 0 6px;font-size:10px;font-weight:700;color:#8E9A94;letter-spacing:1.3px;text-transform:uppercase;mso-line-height-rule:exactly;line-height:13px;"
                    >
                      What you ordered
                    </td>
                    <td
                      class="muted"
                      align="right"
                      style="padding:0 0 6px;font-size:10px;font-weight:700;color:#8E9A94;letter-spacing:0.6px;mso-line-height-rule:exactly;line-height:13px;"
                    >
                      {{itemCountLabel}}
                    </td>
                  </tr>

                  {{#each items}}
                    <tr>
                      <td
                        class="hairline ink"
                        colspan="2"
                        style="padding:14px 0;border-top:1px solid #EDF0EE;font-size:15px;font-weight:700;color:#0F1A14;mso-line-height-rule:exactly;line-height:20px;"
                      >
                        {{this.name}}
                        <span
                          class="muted"
                          style="display:block;margin-top:4px;font-size:13px;font-weight:400;color:#8E9A94;mso-line-height-rule:exactly;line-height:17px;"
                          >{{#if this.variant}}Size {{this.variant}}
                          &nbsp;·&nbsp; {{/if}}Qty {{this.quantity}}</span
                        >
                      </td>
                    </tr>
                  {{/each}}
                </table>
              </td>
            </tr>

            {{!-- The one panel in the email, because this is the one thing the
                  rider must not miss. Background and border sit on this cell
                  directly — no nested table. States the policy only; it promises
                  no replacement or claims process, because none is defined. --}}
            <tr>
              <td class="gutter" style="padding:26px 32px 0;">
                <div
                  class="warn"
                  style="background-color:#FFF6F1;border-left:3px solid #E86B3D;border-radius:0 8px 8px 0;padding:14px 18px;"
                >
                  <span
                    class="warn-ink"
                    style="display:block;font-size:14px;font-weight:700;color:#8A3A14;mso-line-height-rule:exactly;line-height:19px;"
                    >Final sale — non-refundable</span
                  >
                  <span
                    class="warn-ink"
                    style="display:block;margin-top:5px;font-size:13px;color:#8A3A14;mso-line-height-rule:exactly;line-height:20px;"
                    >Rider gear cannot be returned, exchanged, or refunded once
                    payment is confirmed.</span
                  >
                </div>
              </td>
            </tr>

            {{!-- Delivery and payment facts, so a wrong name, address or number
                  gets caught before the courier is booked. Each fact carries its
                  own label rather than sitting in one stacked block under "Ship
                  to": a rider checking these is checking them one at a time, and
                  an unlabelled line is only obvious to someone who already knows
                  what it should say. "Paid with" names the channel and the time
                  only — never the amount. --}}
            <tr>
              <td class="gutter" style="padding:26px 32px 0;">
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  role="presentation"
                >
                  {{#if fullName}}
                    <tr>
                      <td
                        class="muted stack-label"
                        width="34%"
                        style="padding:0 0 14px;font-size:10px;font-weight:700;color:#8E9A94;letter-spacing:1.3px;text-transform:uppercase;vertical-align:top;mso-line-height-rule:exactly;line-height:18px;"
                      >
                        Full name
                      </td>
                      <td
                        class="ink stack-value unstyled-link"
                        style="padding:0 0 14px;font-size:13px;font-weight:700;color:#0F1A14;vertical-align:top;mso-line-height-rule:exactly;line-height:19px;"
                      >
                        {{fullName}}
                      </td>
                    </tr>
                  {{/if}}
                  {{#if deliveryAddress}}
                    <tr>
                      <td
                        class="muted stack-label"
                        width="34%"
                        style="padding:0 0 14px;font-size:10px;font-weight:700;color:#8E9A94;letter-spacing:1.3px;text-transform:uppercase;vertical-align:top;mso-line-height-rule:exactly;line-height:18px;"
                      >
                        Address
                      </td>
                      <td
                        class="ink stack-value unstyled-link"
                        style="padding:0 0 14px;font-size:13px;color:#3C4A43;vertical-align:top;mso-line-height-rule:exactly;line-height:19px;"
                      >
                        {{deliveryAddress}}
                      </td>
                    </tr>
                  {{/if}}
                  {{#if contactNumber}}
                    <tr>
                      <td
                        class="muted stack-label"
                        width="34%"
                        style="padding:0 0 14px;font-size:10px;font-weight:700;color:#8E9A94;letter-spacing:1.3px;text-transform:uppercase;vertical-align:top;mso-line-height-rule:exactly;line-height:18px;"
                      >
                        Contact number
                      </td>
                      <td
                        class="ink stack-value unstyled-link"
                        style="padding:0 0 14px;font-size:13px;color:#3C4A43;vertical-align:top;mso-line-height-rule:exactly;line-height:19px;"
                      >
                        {{contactNumber}}
                      </td>
                    </tr>
                  {{/if}}
                  {{#if paymentMethod}}
                    <tr>
                      <td
                        class="muted stack-label"
                        style="padding:0 0 14px;font-size:10px;font-weight:700;color:#8E9A94;letter-spacing:1.3px;text-transform:uppercase;vertical-align:top;mso-line-height-rule:exactly;line-height:18px;"
                      >
                        Paid with
                      </td>
                      <td
                        class="ink stack-value unstyled-link"
                        style="padding:0 0 14px;font-size:13px;color:#3C4A43;vertical-align:top;mso-line-height-rule:exactly;line-height:19px;"
                      >
                        {{paymentMethod}}{{#if paidAt}}
                          <span class="muted" style="color:#8E9A94;">
                            · {{paidAt}}</span
                          >
                        {{/if}}
                      </td>
                    </tr>
                  {{/if}}
                </table>
              </td>
            </tr>

            {{!-- Footer --}}
            <tr>
              <td
                class="gutter hairline muted"
                style="padding:16px 32px 30px;font-size:12px;color:#8E9A94;mso-line-height-rule:exactly;line-height:19px;"
              >
                <span
                  class="hairline"
                  style="display:block;border-top:1px solid #EDF0EE;padding-top:18px;"
                >
                  We'll email your tracking number once your gear ships.
                  <br />
                  This is an automated message — please do not reply, as replies
                  to this address are not read.
                  <br /><br />
                  &copy; Dory Delivery
                </span>
              </td>
            </tr>

          </table>
          <!--[if mso]>
          </td></tr></table>
          <![endif]-->
        </td>
      </tr>
    </table>
  </body>
</html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your DORY verification code</title>
  </head>
  <!-- Styles are inline: Gmail strips <style> blocks for non-Google accounts. -->
  <body style="margin:0; padding:0; background-color:#F2F4F6; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F2F4F6;">
      <tr>
        <td align="center" style="padding:32px 12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
            <tr>
              <td align="center" style="padding:0 0 16px 0; font-size:15px; font-weight:700; letter-spacing:0.6px; color:#00BF63; text-transform:uppercase;">
                DORY
              </td>
            </tr>
            <tr>
              <td style="background-color:#FFFFFF; border:1px solid #E5E7EB; border-radius:12px; padding:32px;">
                <h1 style="margin:0 0 12px 0; font-size:20px; line-height:28px; font-weight:700; color:#262626;">
                  Confirm a change to your account
                </h1>
                <p style="margin:0 0 24px 0; font-size:15px; line-height:24px; color:#4B5563;">
                  Hi {{name}}, use the code below to confirm the change to your {{fieldLabel}}.
                </p>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F0FAF4; border:2px solid #00BF63; border-radius:10px;">
                  <tr>
                    <td align="center" style="padding:20px 16px;">
                      <div style="font-size:11px; font-weight:700; letter-spacing:1.4px; color:#6B7280; text-transform:uppercase; margin-bottom:6px;">
                        Verification code
                      </div>
                      <div style="font-family:ui-monospace,Menlo,Consolas,monospace; font-size:34px; line-height:44px; font-weight:700; letter-spacing:8px; color:#008036;">{{otpCode}}</div>
                    </td>
                  </tr>
                </table>

                <p style="margin:16px 0 0 0; font-size:14px; line-height:22px; color:#4B5563; text-align:center;">
                  Expires in <strong style="color:#262626;">{{expiryMinutes}} minutes</strong> &middot; usable once
                </p>

                <p style="margin:24px 0 0 0; font-size:13px; line-height:20px; color:#6B7280;">
                  Didn't ask for this? You can ignore this email &mdash; nothing on your account changes. Never share this code with anyone.
                </p>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:20px 12px 0 12px; font-size:12px; line-height:18px; color:#9CA3AF;">
                This is an automated message from DORY &mdash; replies aren't monitored.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

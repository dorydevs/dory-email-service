<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>New Support Request</title>
    <style type="text/css" rel="stylesheet" media="all">
      @import url("https://fonts.googleapis.com/css?family=Nunito+Sans:400,600,700&display=swap");

      body {
        width: 100% !important;
        height: 100%;
        margin: 0;
        padding: 0;
        -webkit-text-size-adjust: none;
        background-color: #f0faf3;
        color: #234232;
      }

      body,
      td,
      th {
        font-family: "Nunito Sans", Helvetica, Arial, sans-serif;
      }

      td {
        word-break: break-word;
      }

      .preheader {
        display: none !important;
        visibility: hidden;
        mso-hide: all;
        font-size: 1px;
        line-height: 1px;
        max-height: 0;
        max-width: 0;
        opacity: 0;
        overflow: hidden;
      }

      .email-wrapper {
        width: 100%;
        margin: 0;
        padding: 0;
        background-color: #f0faf3;
      }

      .email-content {
        width: 100%;
        margin: 0;
        padding: 0;
      }

      .email-masthead {
        padding: 28px 0 18px;
        text-align: center;
      }

      .email-masthead_name {
        font-size: 18px;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #22a85a;
        text-decoration: none;
      }

      .email-body_inner {
        width: 570px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 6px 22px rgba(31, 138, 76, 0.12);
      }

      .email-hero {
        background: linear-gradient(135deg, #22a85a 0%, #15833f 100%);
        padding: 32px 45px;
        text-align: left;
      }

      .email-hero h1 {
        margin: 0;
        color: #ffffff;
        font-size: 22px;
        font-weight: 700;
      }

      .email-hero p {
        margin: 6px 0 0;
        color: #d8f5e3;
        font-size: 14px;
        line-height: 1.5;
      }

      .content-cell {
        padding: 32px 45px 40px;
      }

      .content-cell p {
        color: #3c5a48;
        font-size: 15px;
        line-height: 1.65;
        margin: 0 0 18px;
      }

      .attributes {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 0 0 24px;
        background-color: #f4fbf6;
        border: 1px solid #d7eede;
        border-radius: 10px;
        overflow: hidden;
      }

      .attributes td {
        padding: 14px 18px;
        font-size: 14px;
        border-bottom: 1px solid #e4f3ea;
      }

      .attributes tr:last-child td {
        border-bottom: none;
      }

      .attributes_label {
        width: 130px;
        color: #1f8a4c;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.6px;
        vertical-align: top;
      }

      .attributes_value {
        color: #234232;
        font-weight: 600;
      }

      .message-box {
        background-color: #ffffff;
        border: 1px solid #d7eede;
        border-left: 4px solid #22a85a;
        border-radius: 8px;
        padding: 18px 20px;
        color: #3c5a48;
        font-size: 15px;
        line-height: 1.7;
        white-space: pre-wrap;
      }

      .reply-button {
        display: inline-block;
        margin-top: 26px;
        padding: 13px 30px;
        background-color: #22a85a;
        color: #ffffff !important;
        font-size: 15px;
        font-weight: 700;
        text-decoration: none;
        border-radius: 8px;
      }

      .email-footer {
        width: 570px;
        margin: 0 auto;
        text-align: center;
      }

      .email-footer p {
        color: #8fb6a0;
        font-size: 12px;
        line-height: 1.6;
        padding: 22px 0;
        margin: 0;
      }

      @media only screen and (max-width: 600px) {
        .email-body_inner,
        .email-footer {
          width: 100% !important;
        }
        .email-hero,
        .content-cell {
          padding-left: 24px !important;
          padding-right: 24px !important;
        }
      }
    </style>
  </head>

  <body>
    <span class="preheader">New partner support request from {{name}}.</span>
    <table class="email-wrapper" width="100%" cellpadding="0" cellspacing="0" role="presentation">
      <tr>
        <td align="center">
          <table class="email-content" width="100%" cellpadding="0" cellspacing="0" role="presentation">
            <tr>
              <td class="email-masthead">
                <a href="https://dorydelivery.com" class="email-masthead_name" style="color: #22a85a; font-weight: 800; text-decoration: none;">DORY DELIVERY</a>
              </td>
            </tr>

            <tr>
              <td width="570" cellpadding="0" cellspacing="0">
                <table class="email-body_inner" align="center" width="570" cellpadding="0" cellspacing="0" role="presentation">
                  <tr>
                    <td class="email-hero">
                      <h1>New Support Request</h1>
                      <p>A partner just reached out through the Contact Support form.</p>
                    </td>
                  </tr>

                  <tr>
                    <td class="content-cell">
                      <p>You&rsquo;ve received a new message from the partner support form. Details are below.</p>

                      <table class="attributes" cellpadding="0" cellspacing="0" role="presentation">
                        <tr>
                          <td class="attributes_label">Name</td>
                          <td class="attributes_value">{{name}}</td>
                        </tr>
                        <tr>
                          <td class="attributes_label">Email</td>
                          <td class="attributes_value">
                            <a href="mailto:{{senderEmail}}" style="color: #1f8a4c; text-decoration: none;">{{senderEmail}}</a>
                          </td>
                        </tr>
                        {{#if submittedAt}}
                        <tr>
                          <td class="attributes_label">Received</td>
                          <td class="attributes_value">{{submittedAt}}</td>
                        </tr>
                        {{/if}}
                      </table>

                      <p style="font-weight: 700; color: #1f8a4c; margin-bottom: 10px;">Message</p>
                      <div class="message-box">{{message}}</div>

                      <div style="text-align: center;">
                        <a href="mailto:{{senderEmail}}" class="reply-button">Reply to {{name}}</a>
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td>
                <table class="email-footer" align="center" width="570" cellpadding="0" cellspacing="0" role="presentation">
                  <tr>
                    <td align="center">
                      <p>
                        &copy; {{year}} Dory Delivery. All rights reserved.<br />
                        This is an automated notification from the partner Contact Support form.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

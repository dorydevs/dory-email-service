<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>Your Dory Rider account is ready</title>
    <style type="text/css" rel="stylesheet" media="all">
      @import url("https://fonts.googleapis.com/css?family=Nunito+Sans:400,600,700,800&display=swap");

      body {
        width: 100% !important;
        height: 100%;
        margin: 0;
        padding: 0;
        -webkit-text-size-adjust: none;
        background-color: #f0faf3;
        color: #234232;
      }

      body, td, th {
        font-family: "Nunito Sans", Helvetica, Arial, sans-serif;
      }

      td { word-break: break-word; }

      .preheader {
        display: none !important;
        visibility: hidden;
        mso-hide: all;
        font-size: 1px;
        line-height: 1px;
        max-height: 0;
        max-width: 0;
        opacity: 0;
        overflow: hidden;
      }

      .email-wrapper { width: 100%; margin: 0; padding: 0; background-color: #f0faf3; }
      .email-content { width: 100%; margin: 0; padding: 0; }

      .email-masthead { padding: 28px 0 18px; text-align: center; }
      .email-masthead_name {
        font-size: 18px;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #22a85a;
        text-decoration: none;
      }

      .email-body_inner {
        width: 570px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 6px 22px rgba(31, 138, 76, 0.12);
      }

      .email-hero {
        background: linear-gradient(135deg, #22a85a 0%, #15833f 100%);
        padding: 34px 45px;
        text-align: left;
      }
      .email-hero .badge {
        display: inline-block;
        margin-bottom: 12px;
        padding: 5px 12px;
        background: rgba(255, 255, 255, 0.18);
        border-radius: 999px;
        color: #eafff1;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
      }
      .email-hero h1 { margin: 0; color: #ffffff; font-size: 23px; font-weight: 800; }
      .email-hero p { margin: 8px 0 0; color: #d8f5e3; font-size: 14px; line-height: 1.5; }

      .content-cell { padding: 32px 45px 40px; }
      .content-cell p { color: #3c5a48; font-size: 15px; line-height: 1.65; margin: 0 0 18px; }

      .credentials {
        background-color: #f4fbf6;
        border: 1px solid #d7eede;
        border-left: 4px solid #22a85a;
        border-radius: 10px;
        padding: 20px 22px;
        margin: 0 0 26px;
      }
      .credentials .cred-label {
        color: #1f8a4c;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.6px;
        margin: 0 0 4px;
      }
      .credentials .cred-value {
        color: #234232;
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 16px;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
      }
      .credentials .cred-value:last-child { margin-bottom: 0; }

      .email-footer { width: 570px; margin: 0 auto; text-align: center; }
      .email-footer p { color: #8fb6a0; font-size: 12px; line-height: 1.6; padding: 22px 0; margin: 0; }

      @media only screen and (max-width: 600px) {
        .email-body_inner, .email-footer { width: 100% !important; }
        .email-hero, .content-cell { padding-left: 24px !important; padding-right: 24px !important; }
      }
    </style>
  </head>

  <body>
    <span class="preheader">Your {{appName}} account is ready — here are your login details.</span>
    <table class="email-wrapper" width="100%" cellpadding="0" cellspacing="0" role="presentation">
      <tr>
        <td align="center">
          <table class="email-content" width="100%" cellpadding="0" cellspacing="0" role="presentation">
            <tr>
              <td class="email-masthead">
                <a href="https://dorydelivery.com" class="email-masthead_name" style="color: #22a85a; text-decoration: none;">{{appName}}</a>
              </td>
            </tr>

            <tr>
              <td width="570" cellpadding="0" cellspacing="0">
                <table class="email-body_inner" align="center" width="570" cellpadding="0" cellspacing="0" role="presentation">
                  <tr>
                    <td class="email-hero">
                      <span class="badge">Account Activated</span>
                      <h1>You&rsquo;re all set, {{fullName}}!</h1>
                      <p>Your {{appName}} account is active. Log in to start accepting deliveries and earning.</p>
                    </td>
                  </tr>

                  <tr>
                    <td class="content-cell">
                      <p>Open the <strong>{{appName}}</strong> app and sign in with the credentials below.</p>

                      <div class="credentials">
                        <p class="cred-label">Username</p>
                        <p class="cred-value">{{username}}</p>
                        <p class="cred-label">Password</p>
                        <p class="cred-value">{{password}}</p>
                      </div>

                      <p style="font-size: 13px; color: #3c5a48; margin-bottom: 24px;">
                        For your security, we recommend changing your password after your first login.
                      </p>

                      <p style="margin-top: 26px;">Ride safe,<br /><strong style="color: #1f8a4c;">The Dory Team</strong></p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td>
                <table class="email-footer" align="center" width="570" cellpadding="0" cellspacing="0" role="presentation">
                  <tr>
                    <td align="center">
                      <p>
                        &copy; Dory Delivery. All rights reserved.<br />
                        This email was sent because a {{appName}} account was created for you.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
